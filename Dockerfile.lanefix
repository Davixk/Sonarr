# syntax=docker/dockerfile:1
# Overlay image for the command-queue-lane fix.
# Builds Sonarr.Core.dll + Sonarr.Api.V3.dll from source with the base image's
# AssemblyVersion so they bind against the untouched sibling assemblies, then
# drops just those two DLLs onto the pinned home-operations base image.

FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build
# Must match the base image's app version so the rebuilt assemblies bind against
# the base's untouched *.Common (a default 10.0.0.* stamp crash-loops on startup).
ARG ASSEMBLY_VERSION=4.0.18.2978
WORKDIR /src
COPY . .
RUN dotnet build src/Sonarr.Api.V3/Sonarr.Api.V3.csproj \
      -c Release \
      -p:SolutionDir=/src/src/ \
      -p:AssemblyVersion=${ASSEMBLY_VERSION} \
      -p:TreatWarningsAsErrors=false \
  && echo "=== located Core/Api.V3 assemblies ===" \
  && find /src -name 'Sonarr.Core.dll' -o -name 'Sonarr.Api.V3.dll' \
  && mkdir -p /overlay \
  && cp /src/_output/net6.0/Sonarr.Core.dll /src/_output/net6.0/Sonarr.Api.V3.dll /overlay/ \
  && ls -la /overlay

FROM ghcr.io/home-operations/sonarr@sha256:2cd77fb3d81909a734d61bb8f71462044cb9d2f187e626a28a05a5c4e4be8fd2
LABEL org.opencontainers.image.source="https://github.com/Davixk/Sonarr"
COPY --from=build /overlay/Sonarr.Core.dll /overlay/Sonarr.Api.V3.dll /app/bin/
